# Copy this file to .env and fill in real values. Never commit .env.
# Only variable names and placeholder values belong in this file (Rules R10).

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_OWNER_ID=123456789

# Transcription and analysis (free tiers preferred; see docs/Memory.md)
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
EXA_API_KEY=your-exa-key

# Notion
NOTION_TOKEN=your-notion-integration-token
# Leave NOTION_DATABASE_ID empty: Jack Sparrow creates the database itself.
# If several pages are shared with the integration, set the parent page ID.
NOTION_DATABASE_ID=
NOTION_PARENT_PAGE_ID=

# Optional
JACK_SPARROW_DATA_DIR=./data
JACK_SPARROW_LOG_LEVEL=INFO
# Chat model for the analysis step. Run `python -m app groq-check` to see models your key can use.
JACK_SPARROW_GROQ_CHAT_MODEL=
