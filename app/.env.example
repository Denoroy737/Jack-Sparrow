# Copy this file to .env and fill in real values. Never commit .env.
# Only variable names and placeholder values belong in this file (Rules R10).

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_OWNER_ID=123456789

# Transcription and analysis (free tiers preferred; see docs/Memory.md)
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
EXA_API_KEY=your-exa-key

# Notion (database is created once by the owner; see docs/Architecture.md section 7)
NOTION_TOKEN=your-notion-integration-token
NOTION_DATABASE_ID=your-notion-database-id

# Optional
JACK_SPARROW_DATA_DIR=./data
JACK_SPARROW_LOG_LEVEL=INFO
